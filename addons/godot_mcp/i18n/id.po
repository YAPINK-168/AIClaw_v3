msgid "tooldetail_builder_tree"
msgstr "Kirim pohon JSON yang menjelaskan node, properti, theme override, anchor, grup, sinyal, dan skrip.\nSeluruh konstruksi dihitung sebagai satu langkah undo."

msgid "tooldetail_knowledge_get"
msgstr "Topik: index, control_hierarchy, critical_properties, common_signals,\ntheme_overrides, anchor_presets, size_flags, layout_modes, script_templates\n\nFilter:\n- class:  Batasi ke satu nama kelas saja (mis. \"Button\", \"Tree\")\n- search: Filter substring pada nama/kunci\n\nContoh:\n- {\"topic\":\"index\"}\n- {\"topic\":\"critical_properties\", \"class\":\"Tree\"}"

msgid "tooldetail_validate_scene"
msgstr "Enam kategori pemeriksaan (semua dijalankan secara default):\n- missing_scripts        Node punya referensi skrip tetapi filenya tidak ada\n- broken_node_paths      Properti bertipe NodePath menunjuk ke node yang tidak ada\n- dangling_signals       Koneksi sinyal persisten ke target yang sudah dibebaskan/hilang\n- off_viewport           Node Control yang rect-nya sepenuhnya di luar viewport\n- container_anchor_misuse Anak Container memakai anchor non-default (akan diabaikan)\n- anti_patterns          Kesalahan umum di Godot 4\n\nFilter melalui:\n- root_path:    Subtree yang diperiksa (default: root scene)\n- checks:       Array nama kategori (default: semua)\n- severity_min: Sembunyikan temuan di bawah info|warning|error (default info)"

msgid "config_failed_detail"
