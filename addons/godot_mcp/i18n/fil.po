msgid "tooldetail_knowledge_get"
msgstr "Mga topic: index, control_hierarchy, critical_properties, common_signals,\ntheme_overrides, anchor_presets, size_flags, layout_modes, script_templates\n\nMga filter:\n- class:  Limitahan sa iisang pangalan ng klase (hal. \"Button\", \"Tree\")\n- search: Substring filter sa mga pangalan/key\n\nMga halimbawa:\n- {\"topic\":\"index\"}\n- {\"topic\":\"critical_properties\", \"class\":\"Tree\"}"

msgid "tooldetail_validate_scene"
msgstr "Anim na kategorya ng pagsusuri (lahat ay tumatakbo bilang default):\n- missing_scripts        May script reference ang node pero wala ang file\n- broken_node_paths      Property na tipong NodePath ay tumuturo sa node na wala\n- dangling_signals       Persistent na signal connection sa target na na-free/nawawala\n- off_viewport           Mga Control node na ang rect ay ganap na nasa labas ng viewport\n- container_anchor_misuse May non-default na anchor ang anak ng Container (babalewalain)\n- anti_patterns          Mga karaniwang pagkakamali sa Godot 4\n\nI-filter sa pamamagitan ng:\n- root_path:    Subtree na susuriin (default: root ng scene)\n- checks:       Array ng mga pangalan ng kategorya (default: lahat)\n- severity_min: Itago ang mga natuklasang mas mababa sa info|warning|error (default info)"

