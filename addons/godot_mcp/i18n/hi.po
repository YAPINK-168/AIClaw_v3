msgid "tooldetail_knowledge_get"
msgstr "विषय: index, control_hierarchy, critical_properties, common_signals,\ntheme_overrides, anchor_presets, size_flags, layout_modes, script_templates\n\nफ़िल्टर:\n- class:  किसी एक क्लास नाम तक सीमित करें (जैसे \"Button\", \"Tree\")\n- search: नामों/कुंजियों पर सबस्ट्रिंग फ़िल्टर\n\nउदाहरण:\n- {\"topic\":\"index\"}\n- {\"topic\":\"critical_properties\", \"class\":\"Tree\"}"

msgid "tooldetail_validate_scene"
msgstr "छह जाँच श्रेणियाँ (डिफ़ॉल्ट रूप से सभी चलती हैं):\n- missing_scripts        नोड में स्क्रिप्ट संदर्भ है पर फ़ाइल मौजूद नहीं\n- broken_node_paths      NodePath प्रकार की प्रॉपर्टी अस्तित्वहीन नोड की ओर इशारा करती है\n- dangling_signals       मुक्त/अनुपस्थित लक्ष्यों से जुड़े स्थायी सिग्नल कनेक्शन\n- off_viewport           वे Control नोड जिनका rect पूरी तरह व्यूपोर्ट के बाहर है\n- container_anchor_misuse Container की संतान में गैर-डिफ़ॉल्ट ऐंकर (अनदेखा किया जाएगा)\n- anti_patterns          Godot 4 की सामान्य गलतियाँ\n\nफ़िल्टर करें:\n- root_path:    जाँचने योग्य सबट्री (डिफ़ॉल्ट: सीन रूट)\n- checks:       श्रेणी नामों की सूची (डिफ़ॉल्ट: सभी)\n- severity_min: info|warning|error से नीचे के परिणाम छिपाएँ (डिफ़ॉल्ट info)"

