# ── firewall reachability hint ──
msgid "fw_title"
msgstr "Network permission needed"

msgid "fw_body_mac"
msgstr "The MCP server port cannot be reached from outside this process — most likely blocked by the macOS firewall. AI client connections and the Google sign-in callback both need this port.\n\nSteps:\n1. If macOS asks \"Do you want Godot to accept incoming network connections?\", click Allow.\n2. If you clicked Deny before: open System Settings → Network → Firewall → Options… and set Godot to \"Allow incoming connections\".\n3. Restart the Godot editor and try again."

msgid "fw_body_win"
msgstr "The MCP server port cannot be reached from outside this process — most likely blocked by the Windows firewall.\n\nWhen Windows Security asks about \"Windows Defender Firewall has blocked some features of this app\", tick your networks and click \"Allow access\"; or allow Godot under Control Panel → Windows Defender Firewall → Allow an app through firewall. Then restart the editor."

msgid "fw_open_settings"
msgstr "Open Firewall Settings"

msgid "fw_dismiss"
msgstr "Don't show again"

msgid "acct_fw_blocked"
msgstr "The firewall is blocking the local port — the Google sign-in callback cannot arrive (see the dialog for steps)"

