msgid "tooldetail_knowledge_get"
msgstr "المواضيع: index, control_hierarchy, critical_properties, common_signals,\ntheme_overrides, anchor_presets, size_flags, layout_modes, script_templates\n\nعوامل التصفية:\n- class:  التقييد باسم فئة واحدة (مثل \"Button\"، \"Tree\")\n- search: تصفية بسلسلة فرعية على الأسماء/المفاتيح\n\nأمثلة:\n- {\"topic\":\"index\"}\n- {\"topic\":\"critical_properties\", \"class\":\"Tree\"}"

msgid "tooldetail_validate_scene"
msgstr "ست فئات للفحص (تُشغَّل جميعها افتراضيًا):\n- missing_scripts        العقدة تحتوي على مرجع لبرنامج نصي لكن الملف غير موجود\n- broken_node_paths      خاصية من النوع NodePath تشير إلى عقدة غير موجودة\n- dangling_signals       اتصالات إشارات دائمة بأهداف مُحرَّرة/مفقودة\n- off_viewport           عُقَد Control يقع مستطيلها بالكامل خارج منفذ العرض\n- container_anchor_misuse عنصر فرعي لـ Container له مرتكزات غير افتراضية (سيتم تجاهلها)\n- anti_patterns          أخطاء شائعة في Godot 4\n\nالتصفية عبر:\n- root_path:    الشجرة الفرعية المراد فحصها (افتراضيًا: جذر المشهد)\n- checks:       مصفوفة بأسماء الفئات (افتراضيًا: all)\n- severity_min: إخفاء النتائج الأقل من info|warning|error (افتراضيًا: info)"

