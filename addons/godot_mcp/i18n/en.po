msgid "tooldetail_builder_tree"
msgstr "Pass a JSON tree describing nodes, properties, theme overrides, anchors, groups, signals, scripts.\nThe whole construction is one undo step."

msgid "tooldetail_knowledge_get"
msgstr "Topics: index, control_hierarchy, critical_properties, common_signals,\ntheme_overrides, anchor_presets, size_flags, layout_modes, script_templates\n\nFilters:\n- class:  Restrict to a single class name (e.g. \"Button\", \"Tree\")\n- search: Substring filter on names/keys\n\nExamples:\n- {\"topic\":\"index\"}\n- {\"topic\":\"critical_properties\", \"class\":\"Tree\"}"

msgid "tooldetail_validate_scene"
msgstr "Six check categories (run all by default):\n- missing_scripts        Node has script reference but file doesn't exist\n- broken_node_paths      Property of type NodePath points to nonexistent node\n- dangling_signals       Persistent signal connections to freed/missing targets\n- off_viewport           Control nodes whose rect lies fully outside viewport\n- container_anchor_misuse Container child has non-default anchors (will be ignored)\n- anti_patterns          Common Godot 4 mistakes\n\nFilter via:\n- root_path:    Subtree to check (default: scene root)\n- checks:       Array of category names (default: all)\n- severity_min: Suppress findings below info|warning|error (default info)"

