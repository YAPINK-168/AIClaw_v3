# ── firewall reachability hint ──
msgid "fw_title"
msgstr "नेटवर्क अनुमति आवश्यक"

msgid "fw_body_mac"
msgstr "MCP सर्वर पोर्ट तक इस प्रोसेस के बाहर से नहीं पहुँचा जा सकता — संभवतः macOS फ़ायरवॉल इसे रोक रहा है। AI क्लाइंट कनेक्शन और Google साइन-इन कॉलबैक दोनों को इस पोर्ट की आवश्यकता है।\n\nचरण:\n1. यदि macOS पूछे \"Do you want Godot to accept incoming network connections?\", तो Allow पर क्लिक करें।\n2. यदि आपने पहले Deny चुना था: System Settings → Network → Firewall → Options… खोलें और Godot को \"Allow incoming connections\" पर सेट करें।\n3. Godot एडिटर पुनः प्रारंभ करें और फिर प्रयास करें।"

msgid "fw_body_win"
msgstr "MCP सर्वर पोर्ट तक इस प्रोसेस के बाहर से नहीं पहुँचा जा सकता — संभवतः Windows फ़ायरवॉल इसे रोक रहा है।\n\nजब Windows Security \"Windows Defender Firewall has blocked some features of this app\" पूछे, तो अपने नेटवर्क चुनें और \"Allow access\" पर क्लिक करें; या Control Panel → Windows Defender Firewall → Allow an app through firewall में Godot को अनुमति दें। फिर एडिटर पुनः प्रारंभ करें।"

msgid "fw_open_settings"
