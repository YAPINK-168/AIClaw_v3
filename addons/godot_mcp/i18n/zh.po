# ── firewall reachability hint ──
msgid "fw_title"
msgstr "需要允许网络访问"

msgid "fw_body_mac"
msgstr "检测到 MCP 服务器端口无法从外部访问，可能被 macOS 防火墙拦截。AI 客户端连接和 Google 登录回调都需要该端口可达。\n\n请按以下步骤操作：\n1. 如果系统弹出「是否允许 Godot 接受传入网络连接」，点击「允许」；\n2. 若之前点过「拒绝」：打开 系统设置 → 网络 → 防火墙 → 选项…，把 Godot 设为「允许传入连接」；\n3. 设置完成后重启 Godot 编辑器再试。"

msgid "fw_body_win"
msgstr "检测到 MCP 服务器端口无法从外部访问，可能被 Windows 防火墙拦截。\n\n当 Windows 安全中心弹出「Windows Defender 防火墙已阻止此应用的部分功能」时，勾选专用/公用网络并点击「允许访问」；或在 控制面板 → Windows Defender 防火墙 → 允许应用通过防火墙 中允许 Godot。设置后重启编辑器再试。"

msgid "fw_open_settings"
msgstr "打开防火墙设置"

msgid "fw_dismiss"
